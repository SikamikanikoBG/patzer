{
  "name": "patzer",
  "version": "7.15.0",
  "private": true,
  "description": "Patzer — your private Chess.com. Self-hosted, AI-coached, family-friendly. Stockfish + your own LLM in one Docker container.",
  "license": "MIT",
  "homepage": "https://github.com/SikamikanikoBG/patzer",
  "repository": {
    "type": "git",
    "url": "https://github.com/SikamikanikoBG/patzer.git"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "start": "npm run start -w server",
    "typecheck": "tsc -b server web --noEmit && tsc -p server/test/tsconfig.json",
    "setup": "node scripts/setup.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx server/test/e2e/pvp-negotiation.ts",
    "test:resume": "tsx server/test/e2e/resume.ts",
    "test:ui": "tsx server/test/e2e/pvp-ui.ts",
    "test:resume-ui": "tsx server/test/e2e/resume-ui.ts"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "concurrently": "^9.0.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.11"
  }
}
