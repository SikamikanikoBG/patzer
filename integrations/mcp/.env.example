# For private OpenAI Secure MCP Tunnel (stdio mode); keep the resulting .env file local and private.
PATZER_URL=http://127.0.0.1:8800
PATZER_USERNAME=your_patzer_username
PATZER_PASSWORD=your_patzer_password

# Only needed for the optional local HTTP bridge, not for ChatGPT's Secure MCP Tunnel.
# Generate with: openssl rand -hex 32
# MCP_API_KEY=replace_with_a_random_64_character_hex_token
# MCP_HOST=127.0.0.1
# MCP_PORT=8811
