# For the OpenAI Secure MCP Tunnel (stdio mode). This file stays on your machine.
# Recommended: run `bash integrations/mcp/scripts/configure-local.sh` instead of editing manually.
PATZER_URL=http://127.0.0.1:8800
PATZER_USERNAME=your_patzer_username
PATZER_PASSWORD_FILE=/full/path/to/private/patzer-password-file

# Optional: only needed for local HTTP MCP clients, NOT ChatGPT's Secure MCP Tunnel.
# MCP_API_KEY=replace_with_a_random_64_character_hex_token
# MCP_HOST=127.0.0.1
# MCP_PORT=8811
